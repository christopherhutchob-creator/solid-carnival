# ── Server ──────────────────────────────────────────────────────────────
PORT=3000

# ── Email (Gmail with App Password) ─────────────────────────────────────
# 1. Enable 2FA on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Your Name

# ── Email (Generic SMTP — alternative to Gmail above) ───────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword

# ── Google Sheets (optional) ─────────────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the Google Sheets API
# 3. Create a Service Account and download its JSON key
# 4. Share your target spreadsheet with the service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID from your sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# ── Follow-up Defaults (days after each send) ────────────────────────────
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7
FOLLOWUP_3_DAYS=14
