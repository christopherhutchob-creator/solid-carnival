# ── Server ──────────────────────────────────────────────────────────────
PORT=3000

# ── Email (Gmail with App Password) ─────────────────────────────────────
# 1. Enable 2FA on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Your Name

# ── Email (Generic SMTP — alternative to Gmail above) ───────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword

# ── Google Sheets (optional) ─────────────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the Google Sheets API
# 3. Create a Service Account and download its JSON key
# 4. Share your target spreadsheet with the service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID from your sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# ── Follow-up Defaults (days after each send) ────────────────────────────
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7
FOLLOWUP_3_DAYS=14

# ── Activity Dashboard — Email via IMAP ──────────────────────────────────
# Uses the same EMAIL_USER / EMAIL_APP_PASSWORD above to read your inbox.
# No extra setup needed for Gmail — it just works.
#
# For non-Gmail providers, override the IMAP server:
# IMAP_HOST=imap.mail.me.com          # Apple iCloud
# IMAP_HOST=outlook.office365.com     # Outlook / Microsoft 365
# IMAP_HOST=imap.mail.yahoo.com       # Yahoo Mail
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASS=your_password_or_app_password

# ── Activity Dashboard — Calendar via ICS feed ───────────────────────────
# No configuration needed here — add calendar URLs directly from the
# Activity Dashboard UI (click "+ Cal" in the Calendar panel).
#
# How to get your ICS URL:
#   Google Calendar : Settings → choose calendar → "Secret address in iCal format"
#   Outlook         : Calendar → Share → "View only (ICS link)"
#   Apple Calendar  : Right-click calendar → Share Calendar → copy webcal:// link
#                     (replace webcal:// with https://)

# ── Activity Dashboard — WhatsApp (scan QR, no API key needed) ───────────
# No configuration needed — click "Connect WhatsApp" in the dashboard and
# scan the QR code with your phone (WhatsApp → Menu → Linked Devices).
# The session is saved so you only need to scan once.
#
# Optional: override the Chrome/Chromium path used by whatsapp-web.js
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser
